# --- Supabase ---
# Found in Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-side only, never expose to the browser. Used for admin actions (inviting users, etc).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
NEXT_PUBLIC_APP_NAME=Worlebury
NEXT_PUBLIC_APP_URL=https://app.worlebury.co.uk
